#include<iostream>
#include<string>
using namespace std;
struct node{
    int data;
    node*next;
    node(int val):data(val),next(nullptr){}
};
class stack{
private:
    node*top;
public:
    stack():top(nullptr){}
    void push(int val){
        node*newnode= new node(val);
        newnode->next=top;
        top=newnode;
        cout<<val<<" is pushed onto the stack"<<endl;
        }
    void pop(){
        if (top==nullptr)
        {
            cout<<" Stack Underflow"<<endl;
            return;
        }
        node*temp=top;
        int poppedvalue=temp->data;
        top=top->next;
        delete temp;
        cout<<poppedvalue<<" is popped from the stack"<<endl;
    }
    void display()
    {
        if(top==nullptr)
        {
            cout<<" Stack is empty"<<endl;
            return;
        }
        cout<<"Elements in the stack: ";
        node*temp=top;
while(temp!=nullptr)
        {
            cout<<temp->data<<(temp->next? " ":"");
            temp=temp->next;
            
        }
            cout<<endl;
        
    }
    
};
int main()
{
    stack st;
    int choice ,value;
    while(cin>>choice)
    {
        if(choice==1)
        {
            if(cin>>value)
            {
                st.push(value);
            }
        }
        else if(choice==2)
        {
            st.pop();
        }
        else if(choice==3)
        {
            st.display();
        }
        else if(choice==4)
        {
            cout<<"Exiting the program"<<endl;
            break;
        }
        else
        {
            cout<<"Invalid choice"<<endl;
        }
    }
    return 0;
}
