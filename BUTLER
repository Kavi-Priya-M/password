import sys
def solve():
    data=sys.stdin.read().split()
    if len(data)<2:return
    a,b=data[0],data[1]
    n=len(a)
    l=0
    while l<n and a[l]==b[l]:
        l+=1
    r=n-1
    while r>=0 and a[r]==b[r]:
        r-=1
    if a[l:r+1][::-1]!=b[l:r+1]:
        print(0)
        return
    ways=1
    i,j=l-1,r+1
    while i>=0 and j<n and a[i]==a[j]:
        ways+=1
        i-=1
        j+=1
    print(ways)
if __name__=="__main__":
    solve()
