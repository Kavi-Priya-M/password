#include<iostream>
#include<algorithm>
using namespace std;
int main()
{
    long long n,p,c,m=0,d=0;
    if(!(cin>>n>>p))
    return 0;
    while(--n>0&&cin>>c)
    {
        long long t=min(c,p-1);
        m=max(m,c-t);
        p=t;
    }
    while((1LL<<d)-1<m)
    {
        d++;
    }
    cout<<d<<endl;
    return 0;
}
