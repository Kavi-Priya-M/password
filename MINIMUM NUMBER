#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
    long long e,n,count=0;
    if(!(cin>>e>>n))
    return 0;
    vector<long long>a(n);
    for(int i=0;i<n;i++)cin>>a[i];
    sort(a.rbegin(),a.rend());
    for(long long drain:a)
    {
        for(int i=0;i<2;i++)
        {
            e-=drain;
            count++;
            if (e<=0)
            {
                cout<<count<<endl;
                return 0;
        
            }
}
    
    cout<<-1<<endl;
    return 0;
}
