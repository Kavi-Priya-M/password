#include<iostream>
#include<unordered_map>
#include<algorithm>
using namespace std;
int main()
{
    int n,v,ma=0;
    if(!(cin>>n))
    return 0;
    unordered_map<int,int>freq;
    for(int i=0;i<n;i++)
    {
        cin>>v;
        int x=v-min(i,n-1-i);
        ma=max(ma,++freq[x]);
    }
    cout<<n-ma<<endl;
    return 0;
}
