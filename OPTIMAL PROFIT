n=int(input())
jobs=[]
for _ in range(n):
    jobs.append(list(map(int,input().split())))
jobs.sort(key=lambda x:x[1])
dp=[job[2]for job in jobs]
for i in range(1,n):
    for j in range(i):
        if jobs[j][1]<=jobs[i][0]:
            if dp[j]+jobs[i][2]>dp[i]:
                dp[i]=dp[j]+jobs[i][2]
print(f"The optimal profit is {max(dp)}")
