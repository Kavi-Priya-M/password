import sys
def is_confusing(num):
    mapping={'0':'0','1':'1','6':'9','8':'8','9':'6'}
    s=str(num)
    rotated_s=""
    for char in s:
        if char not in mapping:
            return False
        rotated_s=mapping[char]+rotated_s
    return int(rotated_s)!=num
def solve():
    input_data=sys.stdin.read().strip()
    if not input_data:
        return
    n=int(input_data)
    count =0
    for i in range(1,n+1):
        if is_confusing(i):
            count +=1
    print(count)
if __name__=="__main__":
    solve()
