 import sys
def full_justify(words,max_width):
    res=[]
    i=0
    n=len(words)
    while i<n:
        line_words=[words[i]]
        line_len=len(words[i])
        i+=1
        while i<n and line_len +1 + len(words[i])<=max_width:
            line_words.append(words[i])
            line_len += 1+ len(words[i])
            i+=1
        if i==n or len(line_words)==1:
            line_str=" ".join(line_words)
            res.append(line_str+" "*(max_width - len(line_str)))
            continue
        
        total_space=max_width-sum(len(w) for w in line_words)
        num_gaps=len(line_words)-1
        space_per_gap,extra_left_slots=divmod(total_space,num_gaps)
        line_output=""
        for j in range(num_gaps):
            line_output+=line_words[j]
            line_output+=" "*(space_per_gap+(1 if j<extra_left_slots else 0))
        line_output +=line_words[-1]
        res.append(line_output)
    return res
def solve():
    data=sys.stdin.read().split()
    if not data:
        return
    n=int(data[0])
    words=data[1:n+1]
    max_width=int(data[n+1])
    for line in full_justify(words,max_width):
        print(line)
if __name__=="__main__":
    solve()
 
