import sys
import math
def solve():
    input_data=sys.stdin.read().split()
    if not input_data:
        return
    it =iter(input_data)
    for n_str in it:
        n=int(n_str)
        k=int(next(it))
    
        numbers=[str(i) for i in range(1,n+1)]
        k-=1
        result=""
        fact=math.factorial(n-1)
        for i in range(n-1,0,-1):
            index=k // fact
            result+=numbers.pop(index)
            k %= fact
            fact //= i
        result+=numbers[0]
        print(result)
if __name__=="__main__":
    solve()
