import sys
def blink(s):
    res=[]
    l,r=0,len(s)-1
    while l<=r:
        res.append(s[l])
        
        if l<r:
            res.append(s[r])
        l+=1    
        r-=1
    return "".join(res)
def solve():
    input_data= sys.stdin.read().split()
    if len(input_data)<2:
        return
    n=int(input_data[0])
    w=input_data[1]
    history=[w]
    curr=blink(w)
    while curr !=w:
        history.append(curr)
        curr=blink(curr)
        cycle_len=len(history)
        step_to_original=(cycle_len - (n % cycle_len)) % cycle_len
        print(history[step_to_original])
if __name__=="__main__":
    solve()
